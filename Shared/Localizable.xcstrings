            "state": "translated",
            "value": "このカードを削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 카드를 삭제할까요?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Karte löschen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar esta tarjeta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cette carte ?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar este cartão?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare questo biglietto?"
          }
        }
      }
    },
