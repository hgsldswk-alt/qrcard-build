    "error.password": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入网络密码，密码不能包含换行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a network password without line breaks."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入網路密碼，密碼中不能換行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "改行を含まないネットワークのパスワードを入力してください。"
          }
        },
        "ko": {
