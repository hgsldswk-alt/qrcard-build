    "privacy.deletion": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可在卡片详情删除本机卡片。系统分享的副本由你选择的接收方或存储位置保管。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete local cards from their detail screen. Copies you share are kept by the destination you choose."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可在卡片詳情刪除本機卡片。分享的副本由你選擇的接收方或儲存位置保管。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内のカードは詳細画面から削除できます。共有したコピーは共有先に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 카드는 상세 화면에서 삭제하세요. 공유한 사본은 받는 곳에 남습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Karten löschst du in ihrer Detailansicht. Geteilte Kopien verwaltet das von dir gewählte Ziel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las tarjetas locales desde su pantalla de detalle. Las copias compartidas quedan en el destino que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les cartes locales depuis leur écran de détail. Les copies partagées restent chez le destinataire choisi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apague cartões locais na tela de detalhes. Cópias compartilhadas ficam com o destino escolhido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina i biglietti locali dalla loro schermata di dettaglio. Le copie condivise restano alla destinazione scelta."
          }
        }
      }
    },
    "privacy.local": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片只存本机，不参加系统备份或云同步。制卡无需联网、注册或授予相册权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cards stay on this device with no system backup or cloud sync. Creating cards requires no internet, account, or photo permissions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片只存在這部裝置，不參加系統備份或雲端同步。製卡無需連網、註冊或授予照片權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードはこの端末内に保存され、システムのバックアップやクラウド同期はしません。カードの作成にネット接続、アカウント、写真へのアクセスは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드는 시스템 백업이나 클라우드 동기화 없이 이 기기에만 남습니다. 카드를 만들 때 인터넷, 계정, 사진 권한이 필요 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten bleiben ohne System-Backup oder Cloud-Sync auf diesem Gerät. Zum Erstellen brauchst du weder Internet noch Konto noch Fotozugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas se quedan en este dispositivo sin copia del sistema ni sincronización en la nube. Crear tarjetas no requiere internet, cuenta ni permiso de fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes restent sur cet appareil, sans sauvegarde système ni synchronisation cloud. Aucune connexion, aucun compte ni accès aux photos n’est nécessaire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cartões ficam neste dispositivo, sem backup do sistema nem sincronização na nuvem. Criar cartões não exige internet, conta ou acesso às fotos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I biglietti restano su questo dispositivo, senza backup di sistema né sincronizzazione cloud. Per crearli non servono internet, account o accesso alle foto."
          }
        }
      }
    },
    "privacy.sensitive": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二维码里包含填写的资料，收到的人可读取。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The QR code contains what you enter. Anyone who receives it can read those details."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 碼內含你填寫的資料，收到的人可讀取。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードには入力した内容が入ります。受け取った人は誰でもその内容を読み取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 코드에는 입력한 내용이 들어갑니다. 받은 사람은 누구나 그 내용을 읽을 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der QR-Code enthält, was du eingibst. Wer ihn bekommt, kann diese Angaben lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código QR contiene lo que escribes. Quien lo reciba puede leer esos datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code QR contient ce que tu saisis. Toute personne qui le reçoit peut lire ces informations."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O QR code contém o que você digitar. Quem recebê-lo pode ler esses dados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice QR contiene ciò che inserisci. Chiunque lo riceva può leggere quei dati."
          }
        }
      }
    },
