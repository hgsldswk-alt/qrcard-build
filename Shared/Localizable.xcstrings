    "error.import": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取版式，请检查口令或 .qrcard 文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read the layout. Check the code or .qrcard file."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取版式，請檢查口令或 .qrcard 檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトを読み込めませんでした。コードか.qrcardファイルを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이아웃을 읽지 못했습니다. 코드나 .qrcard 파일을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout konnte nicht gelesen werden. Prüfe den Code oder die .qrcard-Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el diseño. Revisa el código o el archivo .qrcard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la mise en page. Vérifie le code ou le fichier .qrcard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o layout. Verifique o código ou o arquivo .qrcard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il layout. Controlla il codice o il file .qrcard."
          }
        }
      }
    },
    "error.length": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容超过 512 字节，请缩短后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content exceeds 512 bytes. Shorten it and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容超過 512 位元組，請縮短後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が512バイトを超えています。短くしてもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용이 512바이트를 넘습니다. 줄여서 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhalt ist größer als 512 Byte. Kürze ihn und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido supera los 512 bytes. Acórtalo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu dépasse 512 octets. Raccourcis-le et réessaie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo passa de 512 bytes. Encurte e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto supera 512 byte. Accorcialo e riprova."
          }
        }
      }
    },
