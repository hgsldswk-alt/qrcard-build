          "stringUnit": {
            "state": "translated",
            "value": "你可在卡片详情删除本机卡片。系统分享的副本由你选择的接收方或存储位置保管。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete local cards from their detail screen. Copies you share are kept by the destination you choose."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可在卡片詳情刪除本機卡片。分享的副本由你選擇的接收方或儲存位置保管。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内のカードは詳細画面から削除できます。共有したコピーは共有先に残ります。"
          }
        }
      }
    },
    "privacy.local": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片只存本机，不参加系统备份或云同步。制卡无需联网、注册或授予相册权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cards stay on this device with no system backup or cloud sync. Creating cards requires no internet, account, or photo permissions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片只存在這部裝置，不參加系統備份或雲端同步。製卡無需連網、註冊或授予照片權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードはこの端末内に保存され、システムのバックアップやクラウド同期はしません。カードの作成にネット接続、アカウント、写真へのアクセスは不要です。"
          }
        }
      }
    },
