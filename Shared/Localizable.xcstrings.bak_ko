        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t create the file. Try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法產生成品，請重試。"
