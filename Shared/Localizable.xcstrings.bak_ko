    "error.contact": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入姓名，以及电话或邮箱。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a name and a phone number or email."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入姓名，以及電話或電子郵件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前と、電話番号またはメールアドレスを入力してください。"
          }
        }
      }
    },
    "error.import": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取版式，请检查口令或 .qrcard 文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read the layout. Check the code or .qrcard file."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取版式，請檢查口令或 .qrcard 檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトを読み込めませんでした。コードか.qrcardファイルを確認してください。"
          }
        }
      }
    },
    "error.length": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容超过 512 字节，请缩短后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content exceeds 512 bytes. Shorten it and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容超過 512 位元組，請縮短後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が512バイトを超えています。短くしてもう一度お試しください。"
          }
        }
      }
    },
    "error.link": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入完整的 http 或 https 链接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a complete http or https link."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入完整的 http 或 https 連結。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "http または https から始まる完全なリンクを入力してください。"
          }
        }
      }
    },
    "error.password": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入网络密码，密码不能包含换行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a network password without line breaks."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入網路密碼，密碼中不能換行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "改行を含まないネットワークのパスワードを入力してください。"
          }
        }
      }
    },
    "error.render": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法生成成品，请重试。"
