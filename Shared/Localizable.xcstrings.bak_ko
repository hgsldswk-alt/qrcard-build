    "delete.note": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删除本机卡片。已经分享或保存到其他地方的文件仍可使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the card from this device. Copies you shared or saved elsewhere remain available."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會刪除本機卡片。已分享或存到其他地方的檔案仍可使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカードをこの端末から削除します。共有したり別の場所に保存したりしたコピーは残ります。"
          }
        }
      }
    },
    "delete.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
