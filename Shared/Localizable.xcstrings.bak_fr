    "delete.note": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删除本机卡片。已经分享或保存到其他地方的文件仍可使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the card from this device. Copies you shared or saved elsewhere remain available."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會刪除本機卡片。已分享或存到其他地方的檔案仍可使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカードをこの端末から削除します。共有したり別の場所に保存したりしたコピーは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 카드를 삭제합니다. 이미 공유했거나 다른 곳에 저장한 사본은 남아 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Karte wird von diesem Gerät entfernt. Geteilte oder anderswo gespeicherte Kopien bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto quita la tarjeta de este dispositivo. Las copias que compartiste o guardaste en otro lugar siguen disponibles."
          }
        }
      }
    },
    "delete.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除这张卡？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this card?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除這張卡？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカードを削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 카드를 삭제할까요?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Karte löschen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar esta tarjeta?"
          }
        }
      }
    },
