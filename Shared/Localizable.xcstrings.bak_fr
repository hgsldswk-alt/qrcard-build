    "error.storage": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读写本机卡片，请解锁设备后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t access saved cards. Unlock the device and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀寫本機卡片，請解鎖裝置後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したカードにアクセスできません。端末のロックを解除してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 카드에 접근할 수 없습니다. 기기 잠금을 풀고 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff auf gespeicherte Karten. Entsperre das Gerät und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder a las tarjetas guardadas. Desbloquea el dispositivo e inténtalo de nuevo."
          }
        }
      }
    },
    "error.text": {
      "extractionState": "manual",
