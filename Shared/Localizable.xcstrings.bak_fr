    "error.contact": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入姓名，以及电话或邮箱。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a name and a phone number or email."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入姓名，以及電話或電子郵件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前と、電話番号またはメールアドレスを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름과 전화번호 또는 이메일을 입력하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Namen und eine Telefonnummer oder E-Mail ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un nombre y un teléfono o correo."
          }
        }
      }
    },
    "error.import": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取版式，请检查口令或 .qrcard 文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read the layout. Check the code or .qrcard file."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取版式，請檢查口令或 .qrcard 檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトを読み込めませんでした。コードか.qrcardファイルを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이아웃을 읽지 못했습니다. 코드나 .qrcard 파일을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout konnte nicht gelesen werden. Prüfe den Code oder die .qrcard-Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el diseño. Revisa el código o el archivo .qrcard."
          }
        }
      }
    },
    "error.length": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容超过 512 字节，请缩短后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content exceeds 512 bytes. Shorten it and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容超過 512 位元組，請縮短後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が512バイトを超えています。短くしてもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용이 512바이트를 넘습니다. 줄여서 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhalt ist größer als 512 Byte. Kürze ihn und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido supera los 512 bytes. Acórtalo e inténtalo de nuevo."
          }
        }
      }
    },
    "error.link": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
